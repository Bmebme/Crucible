# —— 统一 LLM (唯一事实源, docs/engineering-plan.md §3) ——
# 所有引擎同一个 LLM: crucible / lightrag / llm-wiki / RAGAS 都从这里取
LLM_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# —— 各服务映射 (引用上面同一份) ——
CRUCIBLE_LLM_BASE=${LLM_BASE}
CRUCIBLE_LLM_API_KEY=${LLM_API_KEY}
CRUCIBLE_LLM_MODEL=${LLM_MODEL}

LLM_BINDING=openai
LLM_BINDING_HOST=${LLM_BASE}
LLM_BINDING_API_KEY=${LLM_API_KEY}
LLM_MODEL=${LLM_MODEL}

LLM_WIKI_LLM_BASE=${LLM_BASE}
LLM_WIKI_LLM_API_KEY=${LLM_API_KEY}
LLM_WIKI_LLM_MODEL=${LLM_MODEL}

# —— 评测 (P6) ——
EVAL_LLM_BINDING_HOST=${LLM_BASE}
EVAL_LLM_BINDING_API_KEY=${LLM_API_KEY}

# —— 其他 ——
PG_PASSWORD=crucible
# 宿主机项目数据目录 (挂载到 crucible 容器 /data)
DATA_ROOT=./data

# 完整 MinerU 镜像 (docs/deploy.md §3.3 工作流本地生成后填写, 跳过 docreader 构建)
# DOCREADER_FULL_IMAGE=deploy-docreader:with-models
