# Crucible 应用薄层 (代码变更只重打这一层, 内网秒级构建, 无需摆渡镜像)
# 前提: 已 docker load 基础镜像 (摆渡 tar 内含 crucible-base:amd64 标签):
#   docker load -i crucible-cpu.tar
# 构建 (crucible 仓库根, 代码经 GitHub 同步):
#   docker build -f deploy/Dockerfile.crucible -t deploy-crucible:amd64-cpu .
# 注意: frontend/dist 是构建产物且被 gitignore, git 拉下的代码没有它
# → 静态资源继承基础镜像里烧入的版本; 前端变更需重打基础镜像
FROM crucible-base:amd64

WORKDIR /srv
COPY src ./src
COPY backend ./backend
# --no-build-isolation: pyproject 无显式 build-system, pip 默认走隔离环境
# 并从 PIP_INDEX_URL (清华源) 下载 setuptools —— 内网不可达, 重试超时
# 分钟级 (薄层构建卡死根因)。镜像内已有 setuptools (torch 依赖带入)
RUN pip install --no-cache-dir --no-deps --no-build-isolation -e .

EXPOSE 8080
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--app-dir", "backend"]
