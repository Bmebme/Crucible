# DocReader 根镜像 (构建配方存档, 实际摆渡镜像由本机 build+烤模型+压平产出)
# 内网使用方式: 摆渡加载后 tag 为 docreader-base:amd64, 应用层见 Dockerfile.docreader
#
# 实测构建要点 (2026-09-04/05):
#   - aliyun 的 torch wheel 校验和不符 → torch 固定走 tuna/pytorch CPU 源
#   - torch 2.6.0+cpu + torchvision 0.21.0+cpu 是可用匹配对 (2.14+cpu 与
#     torchvision 0.29 的 nms 算子不兼容, mineru pipeline 会报
#     "operator torchvision::nms does not exist")
#   - MinerU 模型: HF 镜像缺 5 个目录的 LFS → ModelScope 逐文件补全
#     (scripts/fetch_mineru_models.py); 模型为架构无关数据
#   - 最终镜像经 export/import 压平 (含 ENV PATH 等基础环境变量)
FROM python:3.12-slim

ENV PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 libgl1 libglib2.0-0 curl \
    && rm -rf /var/lib/apt/lists/*

# torch/torchvision 从 pytorch CPU 源 (无 CUDA, 体积 -4GB)
RUN pip install --no-cache-dir --timeout 120 --retries 8 \
        fastapi uvicorn python-multipart "markitdown[pdf,docx,pptx]" \
    && pip install --no-cache-dir --timeout 300 --retries 10 \
        --index-url https://download.pytorch.org/whl/cpu \
        "torch==2.6.0+cpu" "torchvision==0.21.0+cpu" \
    && pip install --no-cache-dir --timeout 120 --retries 8 "mineru[core]"

ENV MINERU_MODEL_SOURCE=huggingface
ENV HF_ENDPOINT=https://hf-mirror.com
ENV HF_HUB_OFFLINE=1
ENV PYTHONUNBUFFERED=1

# 模型在 /root/.cache/huggingface (构建后烧入, 见 docs/deploy.md §3.3)
EXPOSE 8081
