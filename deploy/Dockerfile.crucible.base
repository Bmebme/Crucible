# Crucible 基础镜像 (依赖层 + 嵌入模型) — 内网摆渡用, 一次到位
# 应用层见 Dockerfile.crucible (内网从 git 代码秒级构建, 依赖此镜像)
#
# 构建 (Mac 上, Docker Desktop buildx, amd64 模拟):
#   mkdir -p .hf-bake && cp -al ~/.cache/huggingface/hub/models--BAAI--bge-small-zh-v1.5 .hf-bake/
#   docker buildx build --platform linux/amd64 --load \
#     -f deploy/Dockerfile.crucible.base -t crucible-base:amd64 .
#
# 构建要点 (实测):
#   - deb.debian.org 在模拟构建里会卡死 → 换清华 apt 镜像
#   - torch 走 pytorch CPU wheel 源 (无 CUDA, 镜像 -2GB+)
#   - --timeout/--retries: 构建期网络抖动 (files.pythonhosted.org 超时实测) 自愈
FROM python:3.12-slim-amd64

# 国内镜像加速 (构建期)
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

WORKDIR /srv

# 系统依赖: 仅 libgomp (torch 运行时); 全部 Python 依赖走 wheel, 无需编译工具链
# (build-essential 会撑爆 Docker Desktop 内存限额, 已实测踩坑)
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' \
        /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
    && apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

# 依赖层: 变更极少, 摆渡一次; 代码变更只重建应用薄层
# torch CPU wheel 单文件进构建上下文: pytorch 索引会把 torch 的依赖包
# 重定向到 files.pythonhosted.org, 该 host 超时高发 (两次构建实测死在这)
# → 主 wheel 本地安装, 依赖走 PIP_INDEX_URL (清华源) 稳定
# 下载: curl -L --retry 10 -o .hf-bake/torch-2.14.0+cpu-cp312-cp312-manylinux_2_28_x86_64.whl \
#   "https://download.pytorch.org/whl/cpu/torch-2.14.0%2Bcpu-cp312-cp312-manylinux_2_28_x86_64.whl"
COPY .hf-bake/torch-2.14.0+cpu-cp312-cp312-manylinux_2_28_x86_64.whl /srv/
COPY pyproject.toml ./
RUN pip install --no-cache-dir --timeout 120 --retries 8 \
        /srv/torch-2.14.0+cpu-cp312-cp312-manylinux_2_28_x86_64.whl \
    && pip install --no-cache-dir --timeout 120 --retries 8 \
        lightrag-hku>=1.5.0 sentence-transformers>=3.0 \
        fastapi>=0.115 uvicorn>=0.30 "sqlalchemy[asyncio]>=2.0" asyncpg>=0.29 \
        pydantic-settings>=2.3 python-multipart>=0.0.9 alembic>=1.13 greenlet \
        httpx>=0.27 pydantic>=2.7 pyyaml>=6.0 "mcp<2" \
        "openai<4,>=2" \
    && true

# 嵌入模型烧入镜像 (bge-small-zh-v1.5 = 配置默认, 512 维):
# 运行时 _model_is_cached 命中 → HF_HUB_OFFLINE → 零网络加载
COPY .hf-bake/models--BAAI--bge-small-zh-v1.5 /root/.cache/huggingface/hub/models--BAAI--bge-small-zh-v1.5

# 兜底: 基础镜像里带一份构建当日的代码 (内网没 git 仓库也能直接跑)
COPY src ./src
COPY backend ./backend
COPY frontend/dist ./frontend/dist
RUN pip install --no-cache-dir --no-deps -e .

EXPOSE 8080
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--app-dir", "backend"]
