# Crucible 融合服务 (backend + frontend 静态资源) — 内网 CPU 摆渡版
# 与仓库根 Dockerfile 的区别:
#   - 基础镜像显式 amd64 (内网 x86_64 服务器; 构建机是 arm64, 走 buildx 模拟)
#   - torch 走 pytorch CPU wheel 源 (无 CUDA, 镜像体积 -2GB+)
#   - bge-small-zh-v1.5 嵌入模型烧入镜像 (内网离线, 免 HF 下载)
# 构建 (Mac 上, 需 Docker Desktop buildx):
#   mkdir -p .hf-bake && cp -al ~/.cache/huggingface/hub/models--BAAI--bge-small-zh-v1.5 .hf-bake/
#   docker buildx build --platform linux/amd64 --load \
#     -f deploy/Dockerfile.crucible.cpu -t deploy-crucible:amd64-cpu .
FROM python:3.12-slim-amd64

# 国内镜像加速 (构建期)
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

WORKDIR /srv

# 系统依赖: 仅 libgomp (torch 运行时); 全部 Python 依赖走 wheel, 无需编译工具链
# (build-essential 会撑爆 Docker Desktop 内存限额, 已实测踩坑)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

# 依赖层与代码层分离: 代码变更只失效最后一层 (秒级重建), 不再重下 torch
# --timeout/--retries: 构建期网络抖动 (files.pythonhosted.org 超时实测) 自愈
COPY pyproject.toml ./
RUN pip install --no-cache-dir --timeout 120 --retries 8 \
        --index-url https://download.pytorch.org/whl/cpu "torch==2.14.0" \
    && pip install --no-cache-dir --timeout 120 --retries 8 \
        lightrag-hku>=1.5.0 sentence-transformers>=3.0 \
        fastapi>=0.115 uvicorn>=0.30 "sqlalchemy[asyncio]>=2.0" asyncpg>=0.29 \
        pydantic-settings>=2.3 python-multipart>=0.0.9 alembic>=1.13 greenlet \
        httpx>=0.27 pydantic>=2.7 pyyaml>=6.0 "mcp<2" \
        "openai<4,>=2" \
    && true

# 嵌入模型烧入镜像 (bge-small-zh-v1.5 = 配置默认, 512 维):
# 运行时 _model_is_cached 命中 → HF_HUB_OFFLINE → 零网络加载
COPY .hf-bake/models--BAAI--bge-small-zh-v1.5 /root/.cache/huggingface/hub/models--BAAI--bge-small-zh-v1.5

# 代码层 (变更只需重建这一层)
COPY src ./src
COPY backend ./backend
COPY frontend/dist ./frontend/dist
RUN pip install --no-cache-dir --no-deps -e .

EXPOSE 8080
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--app-dir", "backend"]
