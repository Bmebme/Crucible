# DocReader 应用层 (薄): 代码变更只重打这一层, 秒级构建
# 前提: 内网已 docker load 根镜像 (摆渡 tar 内含 docreader-base:amd64 标签):
#   docker load -i docreader-final.tar
# 构建 (在 crucible 仓库根, 代码经 GitHub 同步):
#   docker build -f deploy/Dockerfile.docreader -t docreader-app .
FROM docreader-base:amd64

WORKDIR /srv
COPY docreader/app ./app

EXPOSE 8081
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8081"]
